@page "/automationsetting"
@using AEHAFmtSender.Shared
@inject HttpClient Http

<h3>AutomationSetting</h3>

<div>
    <div class="form-check">
        <input class="form-check-input" type="checkbox" id="flexSwitchCheckDefault" @bind=aircondPwrLink/>
        <label class="form-check-label" for="flexSwitchCheckDefault">
            エアコンとサーキュレータの電源状態を同期
        </label>
    </div>
    <button class="btn btn-primary" @onclick="OnApplyClick">適用</button>

</div>

@code {
    bool aircondPwrLink = false;
    AutomationConfig cfg = new AutomationConfig();
    private async void OnValueChanged(ChangeEventArgs e)
    {
        //cfg.AircondPwrLink =(bool) e.Value;
        //await Http.PostAsJsonAsync("automationconfig", cfg);
    }

    protected override async Task OnInitializedAsync()
    {
        cfg = await Http.GetFromJsonAsync<AutomationConfig>("/automationconfig") ?? new AutomationConfig();
        aircondPwrLink = cfg.AircondPwrLink;
    }

    private async void OnApplyClick()
    {
        cfg.AircondPwrLink = aircondPwrLink;
        await Http.PostAsJsonAsync("automationconfig", cfg);
    }
}
