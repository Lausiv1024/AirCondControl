@page "/aircond"
@inject HttpClient Http

<PageTitle>AircondControl</PageTitle>
<h3>AircondControl</h3>
<style>
    .controlContainer{
        padding : 20px;
    }

    .controlContainer button{
        padding: 20px;
    }

    .controlContainer a{
        padding: 20px;
    }
</style>
<div>
    <div class="form-check form-switch ">
        <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckDefault" @bind="pwr"></input>
        <label class="form-check-label" for="flexSwitchCheckDefault">Power</label>
    </div>
    <div class="controlContainer">
        <select class="form-select" aria-label="OperationMode Select" @bind="OperationModeSelection">
            @for (int i = 0; i < OperationModes.Count; i++)
            {
                var t = OperationModes[i];
                <option value="@t">@OperationModeTexts[i]</option>
            }
        </select>
    </div>
    @if (OperationModeSelection == OperationMode.DEHUMIDIFICATION)
    {
        <div class="controlContainer">
            <label for="dehumid">除湿強度</label>
            <select class="form-select" id="dehumid" aria-label="Dehumidification Select" @bind="DehumidificationSelection">
                @for (int i = 0; i < Dehumidifications.Count; i++)
                {
                    var d = Dehumidifications[i];
                    <option value="@d">@DehumidificationTexts[i]</option>
                }
            </select>
        </div>
    }
    else
    {
        <div class="controlContainer">
            <label>設定室温</label>
            <input type="number" id="degrees" name="deg" min="16" max="31" @bind="degree"/>
        </div>
    }
    <h4>タイマー設定</h4>
    <div class="controlContainer">
        <select class="form-select" aria-label="Timer Select" @bind="TimerModeSelection">
            @foreach (var t in TimerModes)
            {
                <option value="@t">@t</option>
            }
        </select>
        <div>
            <span class="controlContainer">
                <a>@timerDisplayValue</a>
                <button class="btn btn-primary" @onclick="ButtonAdd">+</button>
                <button class="btn btn-primary" @onclick="ButtonSubtract">-</button>
            </span>
        </div>
    </div>
    <span class="controlContainer">
        <button id="apply" class="btn btn-primary" disabled="@sendButtonDisabled" @onclick="ButtonApply">Apply</button>
        <button id="cancel" class="btn btn-primary" disabled="@sendButtonDisabled" @onclick="ButtonCancel">Cancel</button>
    </span>
</div>
@code {
    bool pwr = false;
    int degree = 28;
    string timerDisplayValue = string.Empty;
    int timerValue = 30;
    const int MAX_TIMER = 720;
    const int MIN_TIMER = 30;
    List<OperationMode> OperationModes = new List<OperationMode> { OperationMode.COOLING,
    OperationMode.DEHUMIDIFICATION, OperationMode.HEATING, OperationMode.VENTILATION};
    List<string> OperationModeTexts = new List<string> { "冷房", "除湿", "暖房", "送風"};

    int operationSelectCount = 0;
    OperationMode OperationModeSelection = OperationMode.COOLING;

    List<TimerMode> TimerModes = new List<TimerMode> { TimerMode.NONE, TimerMode.OFFTIMER, TimerMode.ONTIMER};
    TimerMode TimerModeSelection = TimerMode.NONE;

    List<DehumidificationAdjustments> Dehumidifications = new List<DehumidificationAdjustments> {
    DehumidificationAdjustments.STRONG, DehumidificationAdjustments.NORMAL, DehumidificationAdjustments.WEAK};
    List<string> DehumidificationTexts = new List<string> { "強", "標準", "弱" };
    DehumidificationAdjustments DehumidificationSelection = DehumidificationAdjustments.NORMAL;

    NP081Dto model = new NP081Dto();
    bool sendButtonDisabled = false;

    public void ButtonAdd()
    {
        if (timerValue < MAX_TIMER)
            timerValue += 30;

        updateTimerValue();
    }

    public void ButtonSubtract()
    {
        if (timerValue > MIN_TIMER)
            timerValue -= 30;
        updateTimerValue();
    }

    public async void ButtonApply()
    {
        model.Power = pwr;
        model.TimerLength = timerValue;
        model.OperationMode = OperationModeSelection;
        if (OperationModeSelection == OperationMode.HEATING)
        {
            model.HeatingDegrees = degree;
        }else if (OperationModeSelection == OperationMode.COOLING)
        {
            model.CoolingDegrees = degree;
        }
        model.Degree = degree;
        model.TimerMode = TimerModeSelection;
        model.TimerLength = timerValue;
        model.Dehumidification = DehumidificationSelection;
        sendButtonDisabled = true;
        await Http.PostAsJsonAsync("apiac", model);
        sendButtonDisabled = false;
    }

    public void ButtonCancel()
    {

    }

    private void updateTimerValue()
    {
        timerDisplayValue = $"{timerValue / 60}:{timerValue % 60}";
    }

    protected override async Task OnInitializedAsync()
    {
        model = await Http.GetFromJsonAsync<NP081Dto>("/acget") ?? new NP081Dto();
        applyModelToInputs();
        updateTimerValue();
    }

    /// <summary>サーバから取得した状態を入力欄に反映する。反映しないと Apply 時に既定値で上書きしてしまう。</summary>
    private void applyModelToInputs()
    {
        pwr = model.Power;
        OperationModeSelection = model.OperationMode;
        degree = model.OperationMode == OperationMode.HEATING ? model.HeatingDegrees : model.CoolingDegrees;
        TimerModeSelection = model.TimerMode;
        if (model.TimerLength >= MIN_TIMER && model.TimerLength <= MAX_TIMER)
            timerValue = model.TimerLength;
        DehumidificationSelection = model.Dehumidification;
    }
    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);

        updateTimerValue();
    }
}
