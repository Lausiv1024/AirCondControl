[Unit]
Description=CoolerSystemWebUI (Svelte + ASP.NET proxy to AEHAFmtSender)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/coolersystemwebui
ExecStart=/opt/coolersystemwebui/CoolerSystemWebApi
Environment=ASPNETCORE_ENVIRONMENT=Production
# cloudflared が同一ホストから叩くだけなのでループバックに閉じる (TLS と認証は Cloudflare 側)
Environment=ASPNETCORE_URLS=http://127.0.0.1:5080
# RPi 上の AEHAFmtSender。IP は環境に合わせて変更する。
Environment=RpiProxy__BaseUrl=http://192.168.1.50:5195
# IR 送信 (irsend) の完了待ちがあるので短くしすぎない
Environment=RpiProxy__TimeoutSeconds=15
User=www-data
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
